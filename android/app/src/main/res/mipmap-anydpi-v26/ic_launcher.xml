<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <background>
        <layer-list>
            <item android:drawable="@color/icon_background" />
            <!-- Sin margen: el propio icono ya trae el suyo. La ilustración va al
                 80 % dentro de una zona segura, así que el recorte del lanzador
                 no le come nada. Antes llevaba 8.5dp porque el icono anterior
                 venía a sangre. -->
            <item android:drawable="@mipmap/ic_maskable" />
        </layer-list>
    </background>
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
