# Copia este archivo como .env y completa los valores.
# NUNCA subas el .env real al repositorio.

# development | production | test
NODE_ENV=development
PORT=8000

# Cadena de conexión de MongoDB Atlas o local
MONGO_URL=mongodb://127.0.0.1:27017/expenses-tracker

# Secreto para firmar los JWT. Mínimo 32 caracteres.
# Genéralo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambiame-por-un-secreto-largo-y-aleatorio-de-48-bytes
JWT_EXPIRES_IN=7d

# Orígenes del frontend permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# true si este mismo servicio debe servir frontend/dist (despliegue único)
SERVE_FRONTEND=false

# Opcional: none | lax | strict. Por defecto none en producción (dominios distintos)
# COOKIE_SAMESITE=none

# URL pública del frontend. Los enlaces de los correos (invitaciones y
# recuperar contraseña) apuntan aquí. Por defecto, el primer origen de CORS.
# APP_URL=https://controldegastosiglesia.netlify.app

# Correo saliente. Sin BREVO_API_KEY ni SMTP_HOST los correos no se envían: el
# enlace se escribe en el log y las invitaciones se comparten copiando el enlace.
#
# En Render (plan gratuito) usa Brevo: bloquea los puertos SMTP. Clave en
# brevo.com -> SMTP & API -> API Keys. MAIL_FROM debe ser un remitente
# verificado en Brevo (Senders).
# BREVO_API_KEY=
# MAIL_FROM="Control de Gastos <tu-correo-verificado@gmail.com>"
#
# SMTP, para un hosting que lo permita (se usa solo si no hay BREVO_API_KEY).
# Con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 y una "contraseña de
# aplicación" (no la contraseña normal de la cuenta).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Comprobantes (fotos y PDF de los movimientos) en Cloudinary, con entrega
# AUTENTICADA: no son públicos; se ven con un enlace firmado que caduca en 5 min.
# Sin estas variables, adjuntar un comprobante responde 503.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Avisos al teléfono (Web Push): cada cambio del espacio se avisa a los demás
# miembros. Sin estas variables la campana de la app sigue funcionando, pero no
# llega nada al teléfono (la página de avisos lo dice).
# Se generan UNA vez y no se cambian: al cambiarlas, los aparatos ya suscritos
# dejan de recibir avisos hasta que los vuelvan a activar.
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:soporte@controldegastos.app
