# Copia este archivo como .env y completa los valores.
# NUNCA subas el .env real al repositorio.

# development | production | test
NODE_ENV=development
PORT=8000

# Cadena de conexión de MongoDB Atlas o local
MONGO_URL=mongodb://127.0.0.1:27017/expenses-tracker

# Secreto para firmar los JWT. Mínimo 32 caracteres.
# Genéralo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambiame-por-un-secreto-largo-y-aleatorio-de-48-bytes
JWT_EXPIRES_IN=7d

# Orígenes del frontend permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# true si este mismo servicio debe servir frontend/dist (despliegue único)
SERVE_FRONTEND=false

# Opcional: none | lax | strict. Por defecto none en producción (dominios distintos)
# COOKIE_SAMESITE=none
