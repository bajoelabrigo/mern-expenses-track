# Copia este archivo como .env.local y ajusta la URL si hace falta.
# En desarrollo, si no se define, se usa http://localhost:8000/api/v1

VITE_API_URL=http://localhost:8000/api/v1

# Client ID de PayPal para la seccion de socios (/socio). Debe ser el mismo que
# PAYPAL_CLIENT_ID del backend y del mismo lado: sandbox con sandbox, live con
# live. Si se deja vacia, la pagina avisa de que los aportes no estan
# disponibles en vez de romperse.
# En Netlify se define en el panel; se incrusta en el build, asi que al
# cambiarla hay que volver a desplegar.
VITE_PAYPAL_CLIENT_ID=
